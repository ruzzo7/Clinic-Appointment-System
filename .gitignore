# Ignore vendor directory
/vendor/

# Ignore cache directory
/cache/*
!/cache/.gitkeep

# Ignore environment file
.env

# Ignore IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Ignore OS files
.DS_Store
Thumbs.db
desktop.ini

# Ignore log files
*.log

# Ignore temporary files
*.tmp
*.temp
*~
